{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/handler.js": {
      "maxDuration": 300,
      "supportsCancellation": true,
      "includeFiles": "{agent/system-prompt.md,agent/policy.yml,agent/connections/**,agent/skills/**,agent/styles/**,agent/tools/**,agent/attachments/**,agent/properties/**,agent/figures.md,build/knowledge-index.json}",
      "excludeFiles": "{node_modules/@electric-sql/**,agent/raw-course-files/**,agent/knowledge-brain/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/handler?route=:route"
    }
  ]
}

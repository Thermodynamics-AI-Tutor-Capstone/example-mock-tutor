{
  "version": 2,
  "default_connection": "deepseek-pro",
  "max_tool_rounds": 6,
  "connections": {
    "deepseek-pro": {
      "provider": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "temperature": null,
      "apiKeyEnvVar": "DEEPSEEK_API_KEY"
    },
    "deepseek-flash": {
      "provider": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "temperature": null,
      "apiKeyEnvVar": "DEEPSEEK_API_KEY"
    }
  },
  "chatHistory": {
    "provider": "Postgres (Neon on Vercel, embedded PGlite locally)",
    "urlEnvVar": "DATABASE_URL"
  },
  "courseMaterials": {
    "folder": "agent/raw-course-files",
    "cards": "agent/knowledge-brain",
    "tools": ["list_course_files", "search_course_files", "read_course_file", "open_card", "list_cards"]
  },
  "skills": {
    "folder": "agent/skills",
    "tool": "load_skill"
  }
}
